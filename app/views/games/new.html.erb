<%# app/views/games/new.html.erb %>
<h1 class="display-5">New game</h1>

<div class="letters my-3">
  <% @letters.each do |letter| %>
    <span class="letter-tile"><%= letter %></span>
  <% end %>
</div>

<form action="<%= score_path %>" method="post" data-turbo="false">
  <%= hidden_field_tag :authenticity_token, form_authenticity_token %>
  <%= hidden_field_tag :letters, @letters.join(' ') %>

  <label for="word" class="form-label">What is the longest word you can find?</label>
  <div class="input-group">
    <input type="text" name="word" id="word" class="form-control" autofocus autocomplete="off">
    <input type="submit" value="Play" class="btn btn-outline-secondary">
  </div>
</form>
